ANTHROPIC_API_KEY=your-api-key-here
DATABASE_URL=postgresql://langgraph:langgraph@localhost:5442/checkpoints?sslmode=disable

# Optional: send traces to LangSmith. Without these, the scripts run
# exactly the same -- tracing is opt-in and fails open (a bad/missing key
# logs a warning, it doesn't break the run).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=checkpointers-postgres
