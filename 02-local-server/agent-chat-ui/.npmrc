# typescript-eslint@8 pins a peer range on typescript (<6.1.0) that this
# app's own devDependency (typescript ~7.0.2) doesn't satisfy. pnpm (this
# app's original package manager) doesn't fail on that by default; npm does
# unless told to relax peer resolution the same way.
legacy-peer-deps=true

# npm normally symlinks each dependency's CLI into node_modules/.bin/. On a
# filesystem that can't create symlinks (e.g. a Windows-hosted volume bind
# mounted into a Linux sandbox without symlink privileges — the same class
# of issue as uv's venv symlink note in this repo's CLAUDE.md), that fails
# installs outright with EPERM. Skip creating those links; the package.json
# scripts in this app call each tool's script directly with `node
# node_modules/<pkg>/<bin>` instead of relying on them.
bin-links=false
